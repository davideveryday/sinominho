{
    "manifest_version": 3,
    "name": "Sinominho",
    "version": "1.0",
    "permissions": [
        "contextMenus"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "synonyms.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}